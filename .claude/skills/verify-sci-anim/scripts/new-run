#!/usr/bin/env bash
# Makes a fresh run folder for one verification and prints its path.
# Usage: new-run <feature-id>
# The run folder holds evidence (kept) and work/ (scratch, removed by cleanup).
set -euo pipefail
feature=${1:?usage: new-run <feature-id>}
root=${SCI_ANIM_EVIDENCE:-$HOME/.cache/sci_anim-verify}
repo=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
run="$root/$(date +%Y%m%d-%H%M%S)-$feature-$$"
mkdir -p "$run/work"
{
  echo "feature: $feature"
  echo "repo: $repo"
  echo "head: $(git -C "$repo" rev-parse HEAD)"
  echo "dirty: $(git -C "$repo" status --porcelain -- src skills build.rs Cargo.toml Cargo.lock assets | wc -l) changed source paths"
  echo "binary: $("$repo/target/release/sci_anim" --version 2>/dev/null || echo missing)"
  echo "started: $(date +%Y-%m-%dT%H:%M:%S%z)"
} > "$run/run.txt"
echo "$run"
