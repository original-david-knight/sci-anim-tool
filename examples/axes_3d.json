{
  "camera": { "position": [4.8, 10, 7.2], "target": [0, -0.3, 0] },
  "objects": {
    "axes": { "type": "3d-axes",
              "x": { "range": [-3, 3], "length": 5, "label": "x" },
              "y": { "range": [-3, 3], "length": 5, "label": "y" },
              "z": { "range": [0, 8], "length": 2.5, "label": "z" } },
    "bowl": { "type": "surface", "axes": "axes", "z": "x^2 + y^2",
              "material": { "type": "standard", "color": "#58c4dd" } },
    "point": { "type": "sphere", "axes": "axes", "radius": 0.14, "position": [2.6, 0, 7.06], "opacity": 0,
               "material": { "type": "standard", "color": "#fc6255" } },
    "title": { "type": "text", "text": "A paraboloid on 3D axes", "size": 0.45, "attach": { "object": "axes", "offset": [0, 3.2] }, "opacity": 0 },
    "bowl_tex": { "type": "math", "tex": "z = x^2 + y^2", "size": 0.45, "attach": { "object": "axes", "offset": [4, 1.2] }, "opacity": 0 },
    "descent": { "type": "text", "text": "A point rolls down to the lowest z", "size": 0.4, "attach": { "object": "axes", "offset": [0, -3.6] }, "opacity": 0 }
  },
  "timeline": [
    { "type": "play", "duration": 2, "animations": [
      { "type": "create", "object": "axes" },
      { "type": "fade", "object": "title", "to": 1, "end": 1 }
    ] },
    { "type": "play", "duration": 2, "animations": [
      { "type": "create", "object": "bowl" },
      { "type": "fade", "object": "bowl_tex", "to": 1, "start": 1 }
    ] },
    { "type": "play", "duration": 1, "animations": [
      { "type": "fade", "object": "point", "to": 1 },
      { "type": "fade", "object": "descent", "to": 1 }
    ] },
    { "type": "play", "duration": 8, "animations": [
      { "type": "follow", "sets": "camera-position", "law": { "x": "8.65332*sin(0.588003 + tau*t/8)", "y": "10", "z": "8.65332*cos(0.588003 + tau*t/8)" } },
      { "type": "follow", "object": "point", "law": { "x": "2.6*exp(-t/2.5)*cos(t)", "y": "2.6*exp(-t/2.5)*sin(t)", "z": "6.76*exp(-2*t/2.5) + 0.3" } }
    ] },
    { "type": "wait", "duration": 1 }
  ]
}
