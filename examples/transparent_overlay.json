{
  "scene_config": { "width": 640, "height": 360, "fps": 12, "background": "transparent" },
  "objects": {
    "disc": { "type": "circle", "radius": 0.7, "position": [-2, -0.8, 0], "fill": { "color": "#58c4dd", "opacity": 0.6 }, "opacity": 0 },
    "heading": { "type": "text", "text": "Constant speed", "position": [-2, 1.5, 0], "size": 0.7, "opacity": 0 },
    "motion_math": { "type": "math", "tex": "x = v t", "position": [1.7, -0.8, 0], "size": 0.8, "color": "#ffd23f", "opacity": 0 }
  },
  "timeline": [
    { "type": "wait", "duration": 0.25 },
    { "type": "chapter", "id": "motion", "min_duration": 2, "steps": [
      { "type": "play", "duration": 0.5, "animations": [
        { "type": "fade", "object": "disc", "to": 1 },
        { "type": "fade", "object": "heading", "to": 1 },
        { "type": "fade", "object": "motion_math", "to": 1 }
      ] },
      { "type": "play", "duration": 1, "animations": [
        { "type": "move", "object": "disc", "to": [-0.5, -0.8, 0], "easing_curve": "linear" },
        { "type": "move", "object": "heading", "to": [0, 1.5, 0], "easing_curve": "linear" }
      ] }
    ] },
    { "type": "play", "duration": 0.5, "animations": [
      { "type": "fade", "object": "disc", "to": 0 },
      { "type": "fade", "object": "heading", "to": 0 },
      { "type": "fade", "object": "motion_math", "to": 0 }
    ] }
  ]
}
