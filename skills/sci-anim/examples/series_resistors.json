{
  "objects": {
    "heading": { "type": "text", "text": "Resistors in series share one current", "size": 0.5, "position": [0, 3.5, 0] },
    "circuit": { "type": "circuit", "position": [-5.6, -2.4, 0], "spacing": 1.2, "current_dots": { "speed": 0.6 },
      "components": [
        { "id": "B", "kind": "battery", "emf": 12, "from": [0, 0], "to": [0, 3] },
        { "id": "R1", "kind": "resistor", "resistance": 2, "from": [0, 3], "to": [2, 3], "label": "R_1 = 2\\,\\Omega" },
        { "id": "R2", "kind": "resistor", "resistance": 4, "from": [2, 3], "to": [4, 3], "label": "R_2 = 4\\,\\Omega" },
        { "id": "A", "kind": "ammeter", "from": [4, 3], "to": [4, 0] },
        { "kind": "wire", "from": [4, 0], "to": [0, 0] }
      ] },
    "sum": { "type": "math", "tex": "R = R_1 + R_2 = 6\\,\\Omega", "size": 0.5, "position": [3.4, 1.6, 0], "opacity": 0 },
    "ohm": { "type": "math", "tex": "I = \\frac{V}{R} = \\frac{12\\,\\text{V}}{6\\,\\Omega}", "size": 0.5, "position": [3.4, 0.2, 0], "opacity": 0 },
    "current_symbol": { "type": "math", "tex": "I =", "size": 0.45, "align": "right", "position": [2.4, -1.3, 0], "opacity": 0 },
    "current": { "type": "readout", "value": 2, "decimals": 2, "unit": "\\text{ A}", "size": 0.45, "position": [3.0, -1.3, 0], "opacity": 0 },
    "drops_symbol": { "type": "math", "tex": "V_1 + V_2 =", "size": 0.45, "align": "right", "position": [2.4, -2.3, 0], "opacity": 0 },
    "drops": { "type": "readout", "value": 12, "decimals": 2, "unit": "\\text{ V}", "size": 0.45, "position": [3.0, -2.3, 0], "opacity": 0 }
  },
  "timeline": [
    { "type": "play", "duration": 1, "animations": [{ "type": "write", "object": "heading" }] },
    { "type": "play", "duration": 2, "animations": [{ "type": "create", "object": "circuit" }] },
    { "type": "play", "duration": 8, "animations": [
      { "type": "simulate", "circuit": "circuit", "sets": [
        { "object": "current", "value": "circuit.A.current" },
        { "object": "drops", "value": "circuit.R1.voltage + circuit.R2.voltage" }
      ] },
      { "type": "fade", "object": "sum", "to": 1, "end": 1 },
      { "type": "fade", "object": "ohm", "to": 1, "start": 1.5, "end": 2.5 },
      { "type": "fade", "object": "current_symbol", "to": 1, "start": 3, "end": 3.5 },
      { "type": "fade", "object": "current", "to": 1, "start": 3, "end": 3.5 },
      { "type": "fade", "object": "drops_symbol", "to": 1, "start": 4.5, "end": 5 },
      { "type": "fade", "object": "drops", "to": 1, "start": 4.5, "end": 5 }
    ] }
  ]
}
