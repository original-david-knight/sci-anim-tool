{
  "objects": {
    "heading": { "type": "text", "text": "Closing the switch completes the circuit", "size": 0.5, "position": [0, 3.5, 0] },
    "circuit": { "type": "circuit", "position": [-5.6, -2.0, 0], "spacing": 1.3, "current_dots": {},
      "components": [
        { "id": "B", "kind": "battery", "emf": 6, "from": [0, 0], "to": [0, 3] },
        { "id": "S", "kind": "switch", "from": [0, 3], "to": [2, 3] },
        { "kind": "wire", "from": [2, 3], "to": [4, 3] },
        { "id": "L", "kind": "bulb", "resistance": 3, "from": [4, 3], "to": [4, 0] },
        { "kind": "wire", "from": [4, 0], "to": [0, 0] }
      ] },
    "open_note": { "type": "text", "text": "Switch open:\nno closed loop, no current", "size": 0.38, "position": [3.9, 1.3, 0] },
    "closed_note": { "type": "text", "text": "Switch closed:\ncurrent flows, the bulb lights", "size": 0.38, "position": [3.9, 1.3, 0], "opacity": 0 },
    "current_symbol": { "type": "math", "tex": "I =", "size": 0.45, "align": "right", "position": [3.4, -0.2, 0] },
    "current": { "type": "readout", "value": 0, "decimals": 2, "unit": "\\text{ A}", "size": 0.45, "position": [4.0, -0.2, 0] },
    "power_symbol": { "type": "math", "tex": "P =", "size": 0.45, "align": "right", "position": [3.4, -1.2, 0] },
    "power": { "type": "readout", "value": 0, "decimals": 1, "unit": "\\text{ W}", "size": 0.45, "position": [4.0, -1.2, 0] }
  },
  "timeline": [
    { "type": "play", "duration": 1, "animations": [{ "type": "write", "object": "heading" }] },
    { "type": "play", "duration": 2, "animations": [
      { "type": "create", "object": "circuit" },
      { "type": "write", "object": "open_note", "start": 1 },
      { "type": "write", "object": "current_symbol", "start": 1 },
      { "type": "write", "object": "current", "start": 1 },
      { "type": "write", "object": "power_symbol", "start": 1 },
      { "type": "write", "object": "power", "start": 1 }
    ] },
    { "type": "play", "duration": 8, "animations": [
      { "type": "simulate", "circuit": "circuit",
        "switches": [{ "switch": "S", "closed": true, "at": 2 }, { "switch": "S", "closed": false, "at": 6.5 }],
        "sets": [
          { "object": "current", "value": "circuit.L.current" },
          { "object": "power", "value": "circuit.L.power" }
        ] },
      { "type": "fade", "object": "open_note", "to": 0, "start": 1.6, "end": 2 },
      { "type": "fade", "object": "closed_note", "to": 1, "start": 2, "end": 2.4 }
    ] }
  ]
}
