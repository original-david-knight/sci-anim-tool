{
  "objects": {
    "heading": { "type": "text", "text": "A series and parallel network", "size": 0.5, "position": [0, 3.5, 0] },
    "circuit": { "type": "circuit", "position": [-6.0, -2.0, 0], "spacing": 1.05, "current_dots": { "speed": 0.5 },
      "components": [
        { "id": "B", "kind": "battery", "emf": 12, "from": [0, 0], "to": [0, 3] },
        { "id": "R1", "kind": "resistor", "resistance": 2, "from": [0, 3], "to": [3, 3], "label": "R_1 = 2\\,\\Omega" },
        { "id": "R2", "kind": "resistor", "resistance": 6, "from": [3, 3], "to": [3, 0], "label": "R_2 = 6\\,\\Omega" },
        { "kind": "wire", "from": [3, 3], "to": [5, 3] },
        { "id": "R3", "kind": "resistor", "resistance": 3, "from": [5, 3], "to": [5, 0], "label": "R_3 = 3\\,\\Omega" },
        { "kind": "wire", "from": [5, 0], "to": [3, 0] },
        { "kind": "wire", "from": [3, 0], "to": [0, 0] }
      ] },
    "parallel": { "type": "math", "tex": "R_2 \\parallel R_3 = \\frac{6 \\cdot 3}{6 + 3} = 2\\,\\Omega", "size": 0.45, "position": [3.9, 2.0, 0], "opacity": 0 },
    "total": { "type": "math", "tex": "R = R_1 + 2\\,\\Omega = 4\\,\\Omega", "size": 0.45, "position": [3.9, 0.9, 0], "opacity": 0 },
    "i1_symbol": { "type": "math", "tex": "I_1 =", "size": 0.45, "align": "right", "position": [3.4, -0.3, 0], "opacity": 0 },
    "i1": { "type": "readout", "value": 3, "decimals": 2, "unit": "\\text{ A}", "size": 0.45, "position": [4.0, -0.3, 0], "opacity": 0 },
    "i2_symbol": { "type": "math", "tex": "I_2 =", "size": 0.45, "align": "right", "position": [3.4, -1.3, 0], "opacity": 0 },
    "i2": { "type": "readout", "value": 1, "decimals": 2, "unit": "\\text{ A}", "size": 0.45, "position": [4.0, -1.3, 0], "opacity": 0 },
    "i3_symbol": { "type": "math", "tex": "I_3 =", "size": 0.45, "align": "right", "position": [3.4, -2.3, 0], "opacity": 0 },
    "i3": { "type": "readout", "value": 2, "decimals": 2, "unit": "\\text{ A}", "size": 0.45, "position": [4.0, -2.3, 0], "opacity": 0 }
  },
  "timeline": [
    { "type": "play", "duration": 1, "animations": [{ "type": "write", "object": "heading" }] },
    { "type": "play", "duration": 2, "animations": [{ "type": "create", "object": "circuit" }] },
    { "type": "play", "duration": 9, "animations": [
      { "type": "simulate", "circuit": "circuit", "sets": [
        { "object": "i1", "value": "circuit.R1.current" },
        { "object": "i2", "value": "circuit.R2.current" },
        { "object": "i3", "value": "circuit.R3.current" }
      ] },
      { "type": "fade", "object": "parallel", "to": 1, "end": 1 },
      { "type": "fade", "object": "total", "to": 1, "start": 1.5, "end": 2.5 },
      { "type": "fade", "object": "i1_symbol", "to": 1, "start": 3, "end": 3.5 },
      { "type": "fade", "object": "i1", "to": 1, "start": 3, "end": 3.5 },
      { "type": "fade", "object": "i2_symbol", "to": 1, "start": 4, "end": 4.5 },
      { "type": "fade", "object": "i2", "to": 1, "start": 4, "end": 4.5 },
      { "type": "fade", "object": "i3_symbol", "to": 1, "start": 5, "end": 5.5 },
      { "type": "fade", "object": "i3", "to": 1, "start": 5, "end": 5.5 }
    ] }
  ]
}
