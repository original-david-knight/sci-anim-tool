{
  "objects": {
    "heading": { "type": "text", "text": "A pendulum strikes a block", "size": 0.5, "position": [0, 3.5, 0] },
    "support": { "type": "line", "from": [-0.6, 0], "to": [0.6, 0], "position": [-1, 2.5, 0], "stroke": { "color": "#888888", "width": 0.08 } },
    "floor": { "type": "line", "from": [-7, 0], "to": [7, 0], "position": [0, -0.9, 0], "stroke": { "color": "#888888", "width": 0.04 } },
    "bob": { "type": "sphere", "radius": 0.3, "position": [-3.298133, 0.571637, 0], "material": { "type": "standard", "color": "#fc6255" } },
    "rod": { "type": "line", "from": [-1, 2.5, 0], "to": { "object": "bob" }, "stroke": { "color": "#ece6e2", "width": 0.03 } },
    "block": { "type": "polygon", "points": [[-0.4, -0.4], [0.4, -0.4], [0.4, 0.4], [-0.4, 0.4]], "position": [-0.3, -0.5, 0], "fill": { "color": "#58c4dd" } },
    "arc": { "type": "trail", "object": "bob", "length": 1.5, "stroke": { "color": "#fc6255", "width": 0.03 } },

    "bob_speed_label": { "type": "math", "tex": "v_{\\text{bob}} =", "size": 0.4, "align": "right", "position": [3.6, 1.8, 0] },
    "bob_speed": { "type": "readout", "decimals": 2, "unit": "\\text{ m/s}", "size": 0.4, "position": [4.15, 1.8, 0] },
    "block_speed_label": { "type": "math", "tex": "v_{\\text{block}} =", "size": 0.4, "align": "right", "position": [3.6, 1, 0] },
    "block_speed": { "type": "readout", "decimals": 2, "unit": "\\text{ m/s}", "size": 0.4, "position": [4.15, 1, 0] }
  },
  "timeline": [
    { "type": "play", "duration": 1, "animations": [{ "type": "write", "object": "heading" }] },
    { "type": "play", "duration": 4, "animations": [
      { "type": "simulate",
        "bodies": {
          "bob": { "mass": 1, "pivot": [-1, 2.5] },
          "block": { "mass": 1, "friction": 0.3 },
          "floor": { "fixed": true }
        },
        "sets": [
          { "object": "bob_speed", "value": "bob.speed" },
          { "object": "block_speed", "value": "block.speed" }
        ] }
    ] }
  ]
}
