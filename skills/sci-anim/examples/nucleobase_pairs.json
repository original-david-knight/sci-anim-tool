    "at_bond_1": { "type": "line", "from": { "object": "at_pair", "atom": 13 }, "to": { "object": "at_pair", "atom": 21 }, "stroke": { "color": "#ffd23f", "width": 0.05, "dash": [0.08, 0.06] } },
    "at_bond_2": { "type": "line", "from": { "object": "at_pair", "atom": 26 }, "to": { "object": "at_pair", "atom": 7 }, "stroke": { "color": "#ffd23f", "width": 0.05, "dash": [0.08, 0.06] } },
    "gc_bond_1": { "type": "line", "from": { "object": "gc_pair", "atom": 27 }, "to": { "object": "gc_pair", "atom": 6 }, "stroke": { "color": "#ffd23f", "width": 0.05, "dash": [0.08, 0.06] } },
    "gc_bond_2": { "type": "line", "from": { "object": "gc_pair", "atom": 14 }, "to": { "object": "gc_pair", "atom": 20 }, "stroke": { "color": "#ffd23f", "width": 0.05, "dash": [0.08, 0.06] } },
    "gc_bond_3": { "type": "line", "from": { "object": "gc_pair", "atom": 16 }, "to": { "object": "gc_pair", "atom": 19 }, "stroke": { "color": "#ffd23f", "width": 0.05, "dash": [0.08, 0.06] } },

    "at_caption": { "type": "text", "text": "A–T: two hydrogen bonds", "size": 0.36, "position": [-3.4, -3.45, 0], "opacity": 0 },
    "gc_caption": { "type": "text", "text": "G–C: three hydrogen bonds", "size": 0.36, "position": [3.4, -3.45, 0], "opacity": 0 }
