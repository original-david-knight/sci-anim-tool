{
  "objects": {
    "heading": { "type": "text", "text": "A seesaw balances when the moments are equal", "size": 0.5, "position": [0, 3.5, 0] },
    "fulcrum": { "type": "polygon", "points": [[0, 0], [0.5, -1], [-0.5, -1]], "position": [0, -1.08, 0], "fill": { "color": "#888888" } },
    "floor": { "type": "line", "from": [-6, 0], "to": [6, 0], "position": [0, -2.08, 0], "stroke": { "color": "#888888", "width": 0.04 } },
    "plank": { "type": "polygon", "points": [[-3, -0.08], [3, -0.08], [3, 0.08], [-3, 0.08]], "position": [0, -1, 0], "fill": { "color": "#c19a6b" } },
    "left": { "type": "polygon", "points": [[-0.3, -0.3], [0.3, -0.3], [0.3, 0.3], [-0.3, 0.3]], "position": [-1.5, -0.62, 0], "fill": { "color": "#58c4dd" } },
    "right": { "type": "polygon", "points": [[-0.3, -0.3], [0.3, -0.3], [0.3, 0.3], [-0.3, 0.3]], "position": [2.4, -0.62, 0], "fill": { "color": "#fc6255" } },
    "left_mass": { "type": "math", "tex": "2\\text{ kg}", "size": 0.3, "color": "#ece6e2", "attach": { "object": "left", "offset": [0, 0.6] } },
    "right_mass": { "type": "math", "tex": "1.25\\text{ kg}", "size": 0.3, "color": "#ece6e2", "attach": { "object": "right", "offset": [0.95, 0] } },
    "heavier": { "type": "math", "tex": "2\\text{ kg}", "size": 0.3, "color": "#ece6e2", "attach": { "object": "right", "offset": [0.95, 0] }, "opacity": 0 },

    "balance": { "type": "math", "tex": "2 \\cdot 1.5 = 1.25 \\cdot 2.4", "size": 0.45, "position": [0, 2.3, 0] },
    "unbalance": { "type": "math", "tex": "2 \\cdot 1.5 < 2 \\cdot 2.4", "size": 0.45, "position": [0, 2.3, 0], "opacity": 0 },
    "tilt_label": { "type": "math", "tex": "\\text{tilt} =", "size": 0.4, "align": "right", "position": [-0.2, 1.4, 0] },
    "tilt": { "type": "readout", "decimals": 1, "unit": "^\\circ", "size": 0.4, "position": [0.9, 1.4, 0] }
  },
  "timeline": [
    { "type": "play", "duration": 1, "animations": [{ "type": "write", "object": "heading" }, { "type": "write", "object": "balance" }, { "type": "write", "object": "tilt_label" }, { "type": "write", "object": "tilt" }] },
    { "type": "play", "duration": 2, "animations": [
      { "type": "simulate",
        "bodies": {
          "plank": { "mass": 2, "pivot": [0, -1], "restitution": 0.2 },
          "left": { "mass": 2, "friction": 0.8 },
          "right": { "mass": 1.25, "friction": 0.8 }
        },
        "sets": [{ "object": "tilt", "value": "plank.angle" }] }
    ] },
    { "type": "play", "duration": 0.6, "animations": [
      { "type": "fade", "object": "right_mass", "to": 0, "end": 0.3 }, { "type": "fade", "object": "heavier", "to": 1, "start": 0.3 },
      { "type": "fade", "object": "balance", "to": 0, "end": 0.3 }, { "type": "fade", "object": "unbalance", "to": 1, "start": 0.3 }
    ] },
    { "type": "play", "duration": 2, "animations": [
      { "type": "simulate",
        "bodies": {
          "plank": { "mass": 2, "pivot": [0, -1], "restitution": 0.2 },
          "left": { "mass": 2, "friction": 0.8 },
          "right": { "mass": 2, "friction": 0.8 },
          "floor": { "fixed": true }
        },
        "sets": [{ "object": "tilt", "value": "plank.angle" }] }
    ] }
  ]
}
