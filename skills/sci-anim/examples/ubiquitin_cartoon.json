{
  "objects": {
    "heading": { "type": "text", "text": "Ubiquitin, drawn as a cartoon", "size": 0.5, "position": [0, 3.3, 0], "opacity": 0 },

    "protein": { "type": "molecule", "file": "structures/1ubq.pdb", "representation": "cartoon", "scale": [0.16, 0.16, 0.16], "opacity": 0,
      "groups": {
        "helix": { "residues": [{ "chain": "A", "from": 23, "to": 34 }] },
        "sheet": { "residues": [
          { "chain": "A", "from": 1, "to": 7 },
          { "chain": "A", "from": 10, "to": 17 },
          { "chain": "A", "from": 40, "to": 45 },
          { "chain": "A", "from": 48, "to": 50 },
          { "chain": "A", "from": 64, "to": 72 }
        ] }
      } },

    "say_helix": { "type": "text", "text": "Amino acids 23 to 34 coil into an α-helix.", "size": 0.4, "position": [0, -3.4, 0], "opacity": 0 },
    "say_sheet": { "type": "text", "text": "Five β-strands lie side by side in a β-sheet.", "size": 0.4, "position": [0, -3.4, 0], "opacity": 0 }
  },
  "timeline": [
    { "type": "play", "duration": 1.5, "animations": [
      { "type": "fade", "object": "heading", "to": 1 },
      { "type": "fade", "object": "protein", "to": 1 }
    ] },
    { "type": "play", "duration": 10, "animations": [
      { "type": "rotate", "object": "protein", "to": [0, 360, 0], "easing_curve": "linear" },
      { "type": "highlight", "object": "protein", "group": "helix", "to": 1, "start": 0.5, "end": 1.5 },
      { "type": "fade", "object": "say_helix", "to": 1, "start": 0.5, "end": 1.5 },
      { "type": "highlight", "object": "protein", "group": "helix", "to": 0, "start": 4.5, "end": 5 },
      { "type": "fade", "object": "say_helix", "to": 0, "start": 4.5, "end": 5 },
      { "type": "highlight", "object": "protein", "group": "sheet", "to": 1, "start": 5.5, "end": 6.5 },
      { "type": "fade", "object": "say_sheet", "to": 1, "start": 5.5, "end": 6.5 }
    ] },
    { "type": "wait", "duration": 1 }
  ]
