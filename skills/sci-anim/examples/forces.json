{
  "objects": {
    "heading": { "type": "text", "text": "Forces ride on the bodies they act on", "size": 0.5, "position": [0, 3.5, 0] },

    "incline": { "type": "polygon", "points": [[-5.5, -2.6], [1.5, -2.6], [-5.5, 1.4415]], "stroke": { "color": "#888888", "width": 0.04 }, "fill": { "color": "#262626" } },
    "block": { "type": "polygon", "points": [[-0.4, -0.4], [0.4, -0.4], [0.4, 0.4], [-0.4, 0.4]], "position": [-4.3, 1.2093, 0.01], "rotation": [0, 0, -30], "fill": { "color": "#58c4dd" }, "opacity": 0 },
    "gravity": { "type": "arrow", "from": { "object": "block" }, "to": { "object": "block", "offset": [0, -1.6, 0] }, "tip_length": 0.25, "stroke": { "color": "#fc6255", "width": 0.05 }, "opacity": 0 },
    "normal": { "type": "arrow", "from": { "object": "block" }, "to": { "object": "block", "offset": [0.7, 1.2124, 0] }, "tip_length": 0.25, "stroke": { "color": "#83c167", "width": 0.05 }, "opacity": 0 },
    "friction": { "type": "arrow", "from": { "object": "block" }, "to": { "object": "block", "offset": [-0.8660, 0.5, 0] }, "tip_length": 0.25, "stroke": { "color": "#ffd23f", "width": 0.05 }, "opacity": 0 },
    "gravity_caption": { "type": "math", "tex": "mg", "size": 0.45, "color": "#fc6255", "attach": { "object": "block", "offset": [0.55, -1.35] } },
    "normal_caption": { "type": "math", "tex": "N", "size": 0.45, "color": "#83c167", "attach": { "object": "block", "offset": [1.0, 1.4] } },
    "friction_caption": { "type": "math", "tex": "f", "size": 0.45, "color": "#ffd23f", "attach": { "object": "block", "offset": [-1.0, 1.0] } },
    "say_incline": { "type": "text", "text": "As the block slides, each force stays on it.", "size": 0.38, "position": [0, -3.35, 0] },

    "ceiling": { "type": "line", "from": [-1, 0], "to": [1, 0], "position": [0, 2.6, 0], "stroke": { "color": "#888888", "width": 0.06 }, "opacity": 0 },
    "mass": { "type": "polygon", "points": [[-0.4, -0.4], [0.4, -0.4], [0.4, 0.4], [-0.4, 0.4]], "position": [0, 0.3, 0.01], "fill": { "color": "#58c4dd" }, "opacity": 0 },
    "spring": { "type": "spring", "from": [0, 2.6], "to": { "object": "mass", "offset": [0, 0.4, 0] }, "turns": 9, "radius": 0.25, "tube_radius": 0.03, "material": { "type": "standard", "color": "#cccccc" }, "opacity": 0 },
    "rest": { "type": "line", "from": [-0.8, 0], "to": [0.8, 0], "position": [0, -0.5, 0], "stroke": { "color": "#555555", "width": 0.02 }, "opacity": 0 },
    "restoring": { "type": "arrow", "from": { "object": "mass", "offset": [0.7, 0, 0] }, "to": [0.7, -0.5], "tip_length": 0.2, "stroke": { "color": "#fc6255", "width": 0.05 }, "opacity": 0 },
    "hooke": { "type": "math", "tex": "F = -k\\,x", "size": 0.6, "color": "#fc6255", "position": [3.4, 0.8, 0] },
    "say_spring": { "type": "text", "text": "The spring pulls the mass back toward rest.", "size": 0.38, "position": [0, -3.35, 0] }
  },
  "timeline": [
    { "type": "play", "duration": 1.5, "animations": [{ "type": "write", "object": "heading" }, { "type": "create", "object": "incline" }] },
    { "type": "chapter", "id": "incline", "steps": [
      { "type": "play", "duration": 1, "animations": [{ "type": "fade", "object": "block", "to": 1 }] },
      { "type": "play", "duration": 2, "animations": [
        { "type": "fade", "object": "gravity", "to": 1, "end": 0.6 },
        { "type": "write", "object": "gravity_caption", "end": 0.6 },
        { "type": "fade", "object": "normal", "to": 1, "start": 0.7, "end": 1.3 },
        { "type": "write", "object": "normal_caption", "start": 0.7, "end": 1.3 },
        { "type": "fade", "object": "friction", "to": 1, "start": 1.4, "end": 2 },
        { "type": "write", "object": "friction_caption", "start": 1.4, "end": 2 }
      ] },
      { "type": "play", "duration": 3.5, "animations": [
        { "type": "move", "object": "block", "to": [-1.3, -0.5215, 0.01], "easing_curve": "slow-start", "end": 3 },
        { "type": "write", "object": "say_incline", "end": 1.5 }
      ] },
      { "type": "play", "duration": 1, "animations": [
        { "type": "fade", "object": "incline", "to": 0 },
        { "type": "fade", "object": "block", "to": 0 },
        { "type": "fade", "object": "gravity_caption", "to": 0 },
        { "type": "fade", "object": "normal_caption", "to": 0 },
        { "type": "fade", "object": "friction_caption", "to": 0 },
        { "type": "fade", "object": "say_incline", "to": 0 }
      ] }
    ] },
    { "type": "chapter", "id": "spring", "steps": [
      { "type": "play", "duration": 1.5, "animations": [
        { "type": "fade", "object": "ceiling", "to": 1 },
        { "type": "fade", "object": "mass", "to": 1 },
        { "type": "fade", "object": "spring", "to": 1 },
        { "type": "fade", "object": "rest", "to": 1 }
      ] },
      { "type": "play", "duration": 8, "animations": [
        { "type": "follow", "object": "mass", "law": { "x": "0", "y": "-0.5 + 0.8*cos(3*t)", "z": "0.01" } },
        { "type": "fade", "object": "restoring", "to": 1, "end": 0.5 },
        { "type": "write", "object": "hooke", "start": 0.5, "end": 2 },
        { "type": "write", "object": "say_spring", "start": 2, "end": 3.5 }
      ] },
      { "type": "wait", "duration": 1 }
    ] }
  ]
}
