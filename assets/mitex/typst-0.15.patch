+#let get-tex-color(texcolor) = {
+  let parts = if texcolor.has("children") { texcolor.children } else { (texcolor,) }
+  let name = parts.filter(it => it != [ ] and it != [#math.zws]).map(it => if it.has("text") { it.text } else { "?" }).sum(default: "")
+  let named = mitex-color-map.at(lower(name), default: none)
+  if named != none {
+    named
+  } else if name.match(regex("^#[0-9a-fA-F]{6}$")) != none {
+    rgb(name)
+  } else {
+    panic("sci_anim cannot read the color", name)
+  }
 }
 
